# Database
DATABASE_URL=postgresql://mva_user:mva_password@localhost:5433/mva_pipeline
DATABASE_ECHO=false

# File Limits
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=200000
MAX_DATASET_COLUMNS=200
PROCESSING_TIMEOUT_SECONDS=120

# Temporary Storage
TEMP_STORAGE_DIR=./tmp/uploads
MAX_SAMPLE_VALUES=10

# Drill-down Cubes
MIN_CUBE_GROUP_SIZE=5
MAX_DRILL_DOWN_LEVELS=5

# LLM Provider — AZURE_OPENAI_API_KEY/ENDPOINT/DEPLOYMENT/API_VERSION are
# NOT set here: they're inherited from the shared repo-root .env (same
# convention Agent 1/3 already use for their own LLM credentials), so one
# root-level config drop-in covers this service too. Set LLM_PROVIDER=mock
# here only to disable real LLM calls entirely (tests / demos without a key).
LLM_PROVIDER=azure
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_BURST_COOLDOWN_SECONDS=5

# Schema Intelligence
SCHEMA_INTELLIGENCE_PROVIDER=local

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1

# Authentication (leave empty to disable)
API_KEYS=[]
JWT_SECRET=
JWT_ALGORITHM=HS256

# Where the orchestrator's master dataset store lives on a shared filesystem.
# Must be an ABSOLUTE path, and the same directory the orchestrator writes to —
# a relative path resolves against each service's own working directory, which
# silently points the two services at different folders.
MASTER_DATASET_STORAGE_DIR=


# ── Master Dataset store backend ─────────────────────────────────────────
# "local" (default) — MASTER_DATASET_STORAGE_DIR above, a directory shared
#   with the other service. Correct for local development. Leave it unset
#   and nothing below is read; the Azure SDK is never even imported.
# "blob"  — an Azure Blob container both services can reach. For Azure,
#   where the services have separate filesystems and no shared path exists.
#   Needs the Azure extras from the shared dependency set (all three
#   Python services share Data-Profiling-Agent/requirements.txt):
#     pip install -r Data-Profiling-Agent/requirements-azure.txt
# AZURE_BLOB_PREFIX is part of the address — it MUST match in both services.
MASTER_DATASET_BACKEND=local
AZURE_BLOB_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=
AZURE_BLOB_PREFIX=master-datasets
# Only when Managed Identity is unavailable — prefer the account URL above,
# which needs no secret in configuration.
AZURE_BLOB_CONNECTION_STRING=
# Only when several user-assigned identities are attached and one must be picked.
AZURE_BLOB_CLIENT_ID=
